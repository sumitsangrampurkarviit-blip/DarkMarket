<%- include('../partials/header') %>
<h2 style="margin-bottom:1rem">▸ MANAGE PRODUCTS</h2>
<div class="tabs">
  <a href="/admin">Dashboard</a>
  <a href="/admin/products" class="active">Products</a>
  <a href="/admin/categories">Categories</a>
</div>

<div class="card mb-2">
  <h3 style="color:#ddd;margin-bottom:.8rem">Add Product</h3>
  <form method="POST" action="/admin/products" enctype="multipart/form-data">
    <div class="grid grid-2" style="gap:.8rem">
      <div class="form-group"><label>Name</label><input type="text" name="name" required></div>
      <div class="form-group"><label>Category</label>
        <select name="category_id"><% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select>
      </div>
      <div class="form-group"><label>Price (USD)</label><input type="number" name="price" step="0.01" required></div>
      <div class="form-group"><label>Stock</label><input type="number" name="stock" value="0"></div>
    </div>
    <div class="form-group"><label>Description</label><textarea name="description" rows="2"></textarea></div>
    <div class="form-group"><label>Product Image (JPG/PNG/GIF/WEBP, max 5MB)</label><input type="file" name="image" accept="image/*" style="color:var(--text)"></div>
    <label><input type="checkbox" name="featured"> Featured</label>
    <button class="btn mt-1">ADD PRODUCT</button>
  </form>
</div>

<table>
  <tr><th>ID</th><th>Image</th><th>Name</th><th>Caption</th><th>Category</th><th>Price</th><th>Stock</th><th>Active</th><th></th></tr>
  <% products.forEach(p => { %>
  <tr>
    <td class="text-dim"><%= p.id %></td>
    <td>
      <% if(p.image_url){ %>
        <img src="<%= p.image_url %>" style="height:36px;width:50px;object-fit:cover;border-radius:3px;border:1px solid var(--border)">
      <% } else { %>
        <span class="text-dim">—</span>
      <% } %>
    </td>
    <td><%= p.name %> <% if(p.featured){ %><span class="badge badge-green">★</span><% } %></td>
    <td class="text-dim" style="font-size:.8rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= (p.description||'—').substring(0,50) %></td>
    <td class="text-dim"><%= p.cat %></td>
    <td class="text-orange">$<%= p.price.toFixed(2) %></td>
    <td><%= p.stock %></td>
    <td><%= p.is_active ? '✓' : '✗' %></td>
    <td><a href="/admin/products/<%= p.id %>/edit" class="btn btn-sm btn-orange">EDIT</a></td>
  </tr>
  <% }) %>
</table>
<%- include('../partials/footer') %>
