<%- include('partials/header') %>
<h2 style="margin-bottom:1rem">▸ PROFILE</h2>
<div class="grid grid-3 mb-2">
  <div class="stat"><div class="num">$<%= u.balance.toFixed(2) %></div><div class="label">Balance</div></div>
  <div class="stat"><div class="num"><%= orderCount %></div><div class="label">Orders</div></div>
  <div class="stat"><div class="num"><%= ticketCount %></div><div class="label">Tickets</div></div>
</div>
<div style="max-width:500px">
  <div class="card mb-1">
    <h3 style="color:#ddd;margin-bottom:.5rem">Account Info</h3>
    <div class="text-dim" style="font-size:.8rem">Username: <span class="text-green"><%= u.username %></span></div>
    <div class="text-dim" style="font-size:.8rem">Member since: <%= u.created_at %></div>
  </div>
  <div class="card">
    <h3 style="color:#ddd;margin-bottom:.8rem">Update Profile</h3>
    <form method="POST" action="/profile">
      <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= u.email %>"></div>
      <hr>
      <div class="form-group"><label>Current Password (to change password)</label><input type="password" name="current_password"></div>
      <div class="form-group"><label>New Password</label><input type="password" name="new_password"></div>
      <button class="btn">UPDATE</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
