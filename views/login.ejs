<%- include('partials/header') %>
<div style="max-width:400px;margin:3rem auto">
  <h2 class="text-center" style="color:var(--green);margin-bottom:1.5rem">◆ LOGIN</h2>
  <form method="POST" action="/auth/login">
    <div class="form-group">
      <label>Username or Email</label>
      <input type="text" name="username" required autofocus>
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" required>
    </div>
    <button type="submit" class="btn btn-block">ACCESS</button>
  </form>
  <p class="text-center mt-1 text-dim" style="font-size:.85rem">No account? <a href="/auth/register">Register</a></p>
</div>
<%- include('partials/footer') %>
