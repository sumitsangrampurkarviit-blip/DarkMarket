<%- include('partials/header') %>

<!-- Live purchase ticker -->
<div class="ticker-wrap">
  <div class="ticker-label">🟢 LIVE</div>
  <div class="ticker-track" id="ticker"></div>
</div>

<div class="hero">
  <h1>◆ SHADOW CARDS ◆</h1>
  <p>Premium Game Cards — Crypto Only — Untraceable</p>
  <br>
  <a href="/shop" class="btn">ENTER SHOP</a>
</div>

<div class="section">
  <h2>▸ FEATURED LISTINGS</h2>
  <div class="grid grid-4">
    <% featured.forEach(p => { %>
      <div class="card prod-card">
        <div class="prod-img">
          <% if(p.image_url){ %>
            <img src="<%= p.image_url %>" alt="<%= p.name %>">
          <% } else { %>
            <div class="icon">🃏</div>
          <% } %>
        </div>
        <h3><%= p.name %></h3>
        <div class="text-dim" style="font-size:.75rem"><%= p.cat %></div>
        <div class="price">$<%= p.price.toFixed(2) %></div>
        <div class="stock"><%= p.stock > 0 ? p.stock + ' in stock' : 'OUT OF STOCK' %></div>
        <a href="/shop/<%= p.id %>" class="btn btn-sm">VIEW</a>
      </div>
    <% }) %>
  </div>
  <% if(!featured.length){ %><div class="empty"><div class="icon">📦</div><p>No featured items</p></div><% } %>
</div>

<div class="section">
  <h2>▸ CATEGORIES</h2>
  <div class="grid grid-4">
    <% categories.forEach(c => { %>
      <a href="/shop?category=<%= c.slug %>" class="card" style="text-align:center;text-decoration:none">
        <div style="font-size:2rem"><%= c.icon %></div>
        <div style="color:#ddd;margin-top:.3rem"><%= c.name %></div>
      </a>
    <% }) %>
  </div>
</div>
<%- include('partials/footer') %>
